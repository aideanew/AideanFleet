# =============================================================================
# AideanFleet 配置模板 —— 本文件是"模板"，运行期永不写入
# 首次运行 fleet/core/config.py 会把它「原样复制」成 .env，之后只改 .env
# 铁律：
#   1. 本文件与 .env 中禁止出现任何真实密钥 / 邮箱授权码，只写 ${VAR} 占位；
#      真值放系统环境变量，或放仓库外/被忽略的 secrets/.env。
#   2. 段标题行格式固定：  # ===== [SECTION: <段名>] <中文说明> =====
#      共七段：basic / model_pool / roles / executors / email / notify / request
#   3. 键名 FLEET_* 为程序读取用；注释行以 # 开头。
# =============================================================================


# ===== [SECTION: basic] 基础信息 =====
FLEET_PROJECT_NAME=AideanFleet
FLEET_CONSOLE_HOST=127.0.0.1
FLEET_CONSOLE_PORT=5000
FLEET_MANAGER_PORT=9900
FLEET_UI_PORT=3333
# 允许注册为项目的根目录白名单，多个用英文逗号分隔（安全边界，防止写到系统目录）
FLEET_ALLOWED_ROOTS=
FLEET_DEFAULT_PROJECT=AideanFleet
FLEET_TIMEZONE=Asia/Shanghai
# 首次运行 lock 有效期（分钟），控制台锁屏用
FLEET_LOCK_TTL_MINUTES=60


# ===== [SECTION: model_pool] 模型池 =====
# level 数字越小优先级越高（数字小=优先）。
# api_key 只写 ${VAR}，程序运行时从系统环境变量取值；取不到则该模型标记为 no_key。
FLEET_MODEL_1_NAME=bai
FLEET_MODEL_1_LEVEL=1
FLEET_MODEL_1_BASE_URL=https://api.b.ai/v1
FLEET_MODEL_1_MODEL_ID=qwen3.8-flash
FLEET_MODEL_1_API_KEY=${BAI_API_KEY}
FLEET_MODEL_1_HTTP_PROXY=http://127.0.0.1:10808
FLEET_MODEL_1_HTTPS_PROXY=http://127.0.0.1:10808

FLEET_MODEL_2_NAME=amd
FLEET_MODEL_2_LEVEL=2
FLEET_MODEL_2_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
FLEET_MODEL_2_MODEL_ID=DeepSeek-V4-Flash
FLEET_MODEL_2_API_KEY=${AMD_API_KEY}
FLEET_MODEL_2_HTTP_PROXY=
FLEET_MODEL_2_HTTPS_PROXY=

FLEET_MODEL_3_NAME=modelscope
FLEET_MODEL_3_LEVEL=3
FLEET_MODEL_3_BASE_URL=https://api-inference.modelscope.cn/v1
FLEET_MODEL_3_MODEL_ID=ZhipuAI/GLM-5.2
FLEET_MODEL_3_API_KEY=${MODELSCOPE_API_KEY}
FLEET_MODEL_3_HTTP_PROXY=
FLEET_MODEL_3_HTTPS_PROXY=

FLEET_MODEL_4_NAME=nvidia
FLEET_MODEL_4_LEVEL=3
FLEET_MODEL_4_BASE_URL=https://integrate.api.nvidia.com/v1
FLEET_MODEL_4_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b
FLEET_MODEL_4_API_KEY=${NVIDIA_API_KEY}
FLEET_MODEL_4_HTTP_PROXY=
FLEET_MODEL_4_HTTPS_PROXY=

FLEET_MODEL_5_NAME=sensenova
FLEET_MODEL_5_LEVEL=4
FLEET_MODEL_5_BASE_URL=https://token.sensenova.cn/v1
FLEET_MODEL_5_MODEL_ID=sensenova-6.8-flash-lite
FLEET_MODEL_5_API_KEY=${SENSNOVA_API_KEY}
FLEET_MODEL_5_HTTP_PROXY=
FLEET_MODEL_5_HTTPS_PROXY=

FLEET_MODEL_6_NAME=agnes
FLEET_MODEL_6_LEVEL=5
FLEET_MODEL_6_BASE_URL=https://apihub.agnes-ai.com/v1
FLEET_MODEL_6_MODEL_ID=agnes-3.0-flash
FLEET_MODEL_6_API_KEY=${AGNES_API_KEY}
FLEET_MODEL_6_HTTP_PROXY=
FLEET_MODEL_6_HTTPS_PROXY=

# 测试环境禁用项：v3/gpt-6-astra 只在正式环境启用（env_scope=prod）
FLEET_MODEL_7_NAME=v3
FLEET_MODEL_7_LEVEL=9
FLEET_MODEL_7_BASE_URL=https://api.gpt.ge/v1
FLEET_MODEL_7_MODEL_ID=gpt-6-astra
FLEET_MODEL_7_API_KEY=${V3_API_KEY}
FLEET_MODEL_7_HTTP_PROXY=
FLEET_MODEL_7_HTTPS_PROXY=
FLEET_MODEL_7_ENV_SCOPE=prod


# BigModel（智谱 GLM-4.7-Flash，有限额度限并发，level=5）
FLEET_MODEL_8_NAME=bigmodel
FLEET_MODEL_8_LEVEL=5
FLEET_MODEL_8_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FLEET_MODEL_8_MODEL_ID=glm-4.7-flash
FLEET_MODEL_8_API_KEY=${BIGMODEL_API_KEY}
FLEET_MODEL_8_HTTP_PROXY=
FLEET_MODEL_8_HTTPS_PROXY=


# ===== [SECTION: roles] 角色与绑定模型链 =====
# bind_model_name：按顺序尝试，第一个不通（额度/报错）自动切第二个，全耗尽→BLOCKED。
# system_prompt：短说明；完整角色提示词放 prompts/ 目录，此处只放引用路径或一句话设定。
# adapter：执行体适配器名，对应角色C 的 fleet/executors/<adapter>.py
FLEET_ROLE_1_NAME=manager
FLEET_ROLE_1_SYSTEM_PROMPT=你是 Manager，负责拆解、派工、验收与返工决策，不写业务代码。
FLEET_ROLE_1_BIND_MODEL_NAME=agnes,modelscope,amd
FLEET_ROLE_1_ADAPTER=hermes

FLEET_ROLE_2_NAME=ui-1
FLEET_ROLE_2_SYSTEM_PROMPT=你是产品与 UI 设计角色，输出界面结构与交互规范。
FLEET_ROLE_2_BIND_MODEL_NAME=agnes,modelscope
FLEET_ROLE_2_ADAPTER=claudecode

FLEET_ROLE_3_NAME=fe-1
FLEET_ROLE_3_SYSTEM_PROMPT=你是前端开发角色，只改被允许的前端文件。
FLEET_ROLE_3_BIND_MODEL_NAME=agnes,modelscope,amd
FLEET_ROLE_3_ADAPTER=codex

FLEET_ROLE_4_NAME=data-1
FLEET_ROLE_4_SYSTEM_PROMPT=你是数据交互角色，负责接口契约与数据流。
FLEET_ROLE_4_BIND_MODEL_NAME=agnes,modelscope
FLEET_ROLE_4_ADAPTER=opencode

FLEET_ROLE_5_NAME=be-1
FLEET_ROLE_5_SYSTEM_PROMPT=你是后端开发角色（1），只改被允许的后端文件。
FLEET_ROLE_5_BIND_MODEL_NAME=agnes,modelscope,amd
FLEET_ROLE_5_ADAPTER=opencode

FLEET_ROLE_6_NAME=be-2
FLEET_ROLE_6_SYSTEM_PROMPT=你是后端开发角色（2），与 be-1 做文件级隔离。
FLEET_ROLE_6_BIND_MODEL_NAME=modelscope,amd,sensenova
FLEET_ROLE_6_ADAPTER=opencode

FLEET_ROLE_7_NAME=reviewer-1
FLEET_ROLE_7_SYSTEM_PROMPT=你是审查角色，只审查不改码，回执只能是 PASS/PARTIAL/REWORK/BLOCKED。
FLEET_ROLE_7_BIND_MODEL_NAME=agnes,modelscope
FLEET_ROLE_7_ADAPTER=hermes


# ===== [SECTION: executors] 执行体启动命令 =====
# command 为"最高权限启动"口径（见 docs/启动Hermes派工2(英文版).txt §1 与 核心.md 核心3-1）：
# 所有 CLI 都以跳过权限确认的方式启动，避免无人值守时卡在交互确认。
FLEET_EXECUTOR_1_NAME=claudecode
FLEET_EXECUTOR_1_COMMAND=claude -p --output-format json
FLEET_EXECUTOR_1_TIMEOUT=600

FLEET_EXECUTOR_2_NAME=codex
FLEET_EXECUTOR_2_COMMAND=codex exec --full-auto
FLEET_EXECUTOR_2_TIMEOUT=600

FLEET_EXECUTOR_3_NAME=opencode
FLEET_EXECUTOR_3_COMMAND=opencode run
FLEET_EXECUTOR_3_TIMEOUT=600

FLEET_EXECUTOR_4_NAME=hermes
FLEET_EXECUTOR_4_COMMAND=hermes
FLEET_EXECUTOR_4_TIMEOUT=600

FLEET_EXECUTOR_5_NAME=cline
FLEET_EXECUTOR_5_COMMAND=cline --yolo --json
FLEET_EXECUTOR_5_TIMEOUT=600

FLEET_EXECUTOR_6_NAME=gemini
FLEET_EXECUTOR_6_COMMAND=gemini -p --approval-mode=yolo --output-format json
FLEET_EXECUTOR_6_TIMEOUT=600

FLEET_EXECUTOR_7_NAME=grok
FLEET_EXECUTOR_7_COMMAND=grok --no-auto-update --always-approve -p --output-format json
FLEET_EXECUTOR_7_TIMEOUT=600


# ===== [SECTION: email] 邮箱 SMTP（收发件人 / host / port / 授权码 全用 ${VAR}） =====
FLEET_SMTP_ENABLED=0
FLEET_SMTP_SENDER=${SMTP_SENDER}
FLEET_SMTP_RECEIVER=${SMTP_RECEIVER}
FLEET_SMTP_HOST=${SMTP_HOST}
FLEET_SMTP_PORT=${SMTP_PORT}
FLEET_SMTP_AUTH_CODE=${SMTP_AUTH_CODE}
FLEET_SMTP_USE_SSL=1


# ===== [SECTION: notify] 提醒开关 4 项 =====
# 1=开 0=关。默认：任务开始=关、任务结束=开、Manager额度不足=开、执行角色额度不足=开
FLEET_NOTIFY_ON_TASK_START=0
FLEET_NOTIFY_ON_TASK_END=1
FLEET_NOTIFY_ON_MANAGER_QUOTA=1
FLEET_NOTIFY_ON_ROLE_QUOTA=1


# ===== [SECTION: request] 请求超时与重试次数 =====
# 口径（工作包 §9.4-2）：429/超时 → 等 RETRY_DELAY 秒重试，最多 RETRY_MAX 次；
# 仍失败才切换下一候选模型。401/402/403/quota_exhausted/model_not_found 为硬失败，立即切换。
FLEET_REQUEST_TIMEOUT=600
FLEET_REQUEST_RETRY_MAX=10
FLEET_REQUEST_RETRY_DELAY=10


# ===== [SECTION: settings] 可靠性参数（REL-01） =====
# 任务在 DOING 停留超过该秒数 -> 事件 task:stuck；超过 2 倍 -> BLOCKED 等人工（fleet/rel/retry_timer.py）
FLEET_SETTINGS_TASK_STUCK_SECONDS=1800

# 控制台进程守护开关：1 = launch_core 随服务拉起 watchdog（缺省关，遵循 FLEET_SCHEDULER 模式）
FLEET_WATCHDOG=0
# 服务重启后的调度总线初始模式：auto = 有活跃任务即自动推进（用户口径全程自动）；缺省 step
FLEET_SCHEDULER_MODE=auto
