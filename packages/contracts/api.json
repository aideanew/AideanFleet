{
 "$id": "api.json",
 "title": "AideanFleet Kernel/Setup HTTP API（S1–S6 所需全集）",
 "conventions": {
  "base": "http://127.0.0.1:<FLEET_CONSOLE_PORT>，默认 3100（U-03 已裁决，TASK-008 落地）",
  "auth": "除 public 标注外全部需要会话令牌：Authorization: Bearer <token> > Cookie fleet_token > ?token=（已确认：fleet/console/server.py:170-178 token_of）",
  "content_type": "application/json; charset=utf-8",
  "success_envelope": {
   "ok": true
  },
  "error_envelope": {
   "$ref": "errors.json#/$defs/ErrorBody"
  },
  "pagination": {
   "style": "cursor",
   "request": {
    "limit": "1..500，默认 100",
    "cursor": "上一页返回的 next_cursor（不透明字符串）"
   },
   "response": {
    "items": "array",
    "next_cursor": "string|null"
   }
  },
  "idempotency": "所有 POST 创建类接口接受请求头 Idempotency-Key（≤64 字符）；同 key 24h 内重复请求返回首次结果，不重复创建。"
 },
 "endpoints": [
  {
   "id": "health",
   "method": "GET",
   "path": "/api/health",
   "public": true,
   "status": "existing",
   "response": {
    "type": "object",
    "required": [
     "version",
     "db",
     "events",
     "config",
     "frontend_built"
    ],
    "properties": {
     "version": {
      "type": "string"
     },
     "db": {
      "type": "boolean"
     },
     "events": {
      "type": "boolean"
     },
     "config": {
      "type": "boolean"
     },
     "frontend_built": {
      "type": "boolean"
     }
    }
   }
  },
  {
   "id": "goals.create",
   "method": "POST",
   "path": "/api/kernel/goals",
   "status": "new",
   "slice": "S1",
   "idempotent_with_key": true,
   "request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "title",
     "requirements"
    ],
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
     },
     "requirements": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
     },
     "workspace": {
      "type": "string",
      "description": "缺省 = workspace.allowed_roots[0]/<slug(title)>；必须落在 allowed_roots 内"
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "ok",
     "goal",
     "plan_todo_id"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "goal": {
      "$ref": "schemas/goal.json"
     },
     "plan_todo_id": {
      "type": "string"
     }
    }
   },
   "errors": [
    "VALIDATION_FAILED",
    "WORKSPACE_NOT_ALLOWED",
    "UNAUTHORIZED",
    "SETUP_INCOMPLETE"
   ],
   "effect": "同事务：create_goal + create_todo(kind=plan, packet=requirements)，事件 goal:created、todo:created"
  },
  {
   "id": "goals.list",
   "method": "GET",
   "path": "/api/kernel/goals",
   "status": "new",
   "slice": "S1",
   "paginated": true,
   "response": {
    "type": "object",
    "required": [
     "ok",
     "items",
     "next_cursor"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "items": {
      "type": "array",
      "items": {
       "$ref": "schemas/goal.json"
      }
     },
     "next_cursor": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  {
   "id": "attention",
   "method": "GET",
   "path": "/api/kernel/attention",
   "status": "existing",
   "response": {
    "type": "object",
    "required": [
     "ok",
     "counts",
     "needs_user",
     "running",
     "blocked",
     "done_recent",
     "goals"
    ],
    "properties": {
     "counts": {
      "type": "object",
      "required": [
       "needs_user",
       "running",
       "blocked",
       "done",
       "open",
       "superseded"
      ],
      "properties": {
       "needs_user": {
        "type": "integer",
        "minimum": 0
       },
       "running": {
        "type": "integer",
        "minimum": 0
       },
       "blocked": {
        "type": "integer",
        "minimum": 0
       },
       "done": {
        "type": "integer",
        "minimum": 0
       },
       "open": {
        "type": "integer",
        "minimum": 0
       },
       "superseded": {
        "type": "integer",
        "minimum": 0
       }
      }
     },
     "needs_user": {
      "type": "array",
      "items": {
       "$ref": "schemas/todo.json"
      }
     },
     "running": {
      "type": "array",
      "items": {
       "$ref": "schemas/todo.json"
      }
     },
     "blocked": {
      "type": "array",
      "items": {
       "$ref": "schemas/todo.json"
      }
     },
     "done_recent": {
      "type": "array",
      "items": {
       "$ref": "schemas/todo.json"
      }
     },
     "goals": {
      "type": "array",
      "items": {
       "$ref": "schemas/goal.json"
      }
     }
    }
   }
  },
  {
   "id": "todos.list",
   "method": "GET",
   "path": "/api/kernel/todos",
   "status": "existing（需补分页）",
   "paginated": true,
   "query": {
    "goal_id": "string?",
    "status": "Todo.status?"
   },
   "response": {
    "type": "object",
    "required": [
     "ok",
     "items",
     "next_cursor"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "items": {
      "type": "array",
      "items": {
       "$ref": "schemas/todo.json"
      }
     },
     "next_cursor": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  {
   "id": "todos.get",
   "method": "GET",
   "path": "/api/kernel/todos/{todo_id}",
   "status": "new",
   "slice": "S1",
   "response": {
    "type": "object",
    "required": [
     "ok",
     "todo",
     "attempts",
     "evidence"
    ],
    "properties": {
     "todo": {
      "$ref": "schemas/todo.json"
     },
     "attempts": {
      "type": "array",
      "items": {
       "$ref": "schemas/attempt.json"
      }
     },
     "evidence": {
      "type": "array",
      "items": {
       "$ref": "resources.json#/$defs/EvidenceRef"
      }
     }
    }
   },
   "errors": [
    "TODO_NOT_FOUND",
    "UNAUTHORIZED"
   ]
  },
  {
   "id": "todos.reopen",
   "method": "POST",
   "path": "/api/kernel/todos/{todo_id}/reopen",
   "status": "existing",
   "response": {
    "type": "object",
    "required": [
     "ok",
     "todo"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "todo": {
      "$ref": "schemas/todo.json"
     }
    }
   },
   "errors": [
    "TODO_NOT_FOUND",
    "ILLEGAL_TRANSITION",
    "UNAUTHORIZED"
   ]
  },
  {
   "id": "events.list",
   "method": "GET",
   "path": "/api/kernel/events",
   "status": "existing",
   "query": {
    "limit": "1..500"
   },
   "response": {
    "type": "object",
    "required": [
     "ok",
     "items"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "items": {
      "type": "array",
      "items": {
       "$ref": "events.json#/$defs/Event"
      }
     }
    }
   }
  },
  {
   "id": "steer.create",
   "method": "POST",
   "path": "/api/kernel/goals/{goal_id}/steer",
   "status": "new",
   "slice": "S6",
   "idempotent_with_key": true,
   "request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "message"
    ],
    "properties": {
     "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "ok",
     "steer_todo_id"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "steer_todo_id": {
      "type": "string"
     }
    }
   },
   "errors": [
    "GOAL_NOT_FOUND",
    "VALIDATION_FAILED"
   ]
  },
  {
   "id": "plan.diff.get",
   "method": "GET",
   "path": "/api/kernel/todos/{todo_id}/diff",
   "status": "new",
   "slice": "S6",
   "response": {
    "type": "object",
    "required": [
     "ok",
     "diff",
     "decision"
    ],
    "properties": {
     "diff": {
      "$ref": "schemas/plan-diff.json"
     },
     "decision": {
      "enum": [
       "pending",
       "approved",
       "rejected"
      ]
     }
    }
   }
  },
  {
   "id": "plan.decide",
   "method": "POST",
   "path": "/api/kernel/todos/{todo_id}/decision",
   "status": "new",
   "slice": "S6",
   "idempotent_with_key": true,
   "request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "decision"
    ],
    "properties": {
     "decision": {
      "enum": [
       "approve",
       "reject"
      ]
     },
     "note": {
      "type": "string",
      "maxLength": 1000
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "ok",
     "todo"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "todo": {
      "$ref": "schemas/todo.json"
     }
    }
   },
   "errors": [
    "TODO_NOT_FOUND",
    "DECISION_ALREADY_MADE",
    "ILLEGAL_TRANSITION"
   ]
  },
  {
   "id": "setup.status",
   "method": "GET",
   "path": "/api/setup/status",
   "public": "loopback_only",
   "status": "new",
   "slice": "S2",
   "note": "首次运行时用户尚无项目/会话，必须免会话；仅当请求来源为 127.0.0.1/::1 时放行（见 identity.json）",
   "response": {
    "type": "object",
    "required": [
     "ok",
     "status"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "status": {
      "$ref": "schemas/setup-status.json"
     }
    }
   }
  },
  {
   "id": "setup.install",
   "method": "POST",
   "path": "/api/setup/install",
   "public": "loopback_only",
   "status": "new",
   "slice": "S2",
   "idempotent_with_key": true,
   "request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "components"
    ],
    "properties": {
     "components": {
      "type": "array",
      "minItems": 1,
      "items": {
       "$ref": "schemas/setup-status.json#/$defs/Component/properties/name"
      }
     },
     "mirror": {
      "enum": [
       "auto",
       "official",
       "cn"
      ],
      "default": "auto"
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "ok",
     "job_id"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "job_id": {
      "type": "string"
     }
    }
   },
   "errors": [
    "INSTALL_IN_PROGRESS",
    "VALIDATION_FAILED",
    "PLATFORM_UNSUPPORTED"
   ]
  },
  {
   "id": "setup.job",
   "method": "GET",
   "path": "/api/setup/jobs/{job_id}",
   "public": "loopback_only",
   "status": "new",
   "slice": "S2",
   "response": {
    "type": "object",
    "required": [
     "ok",
     "job_id",
     "state",
     "steps"
    ],
    "properties": {
     "state": {
      "enum": [
       "queued",
       "running",
       "succeeded",
       "failed"
      ]
     },
     "steps": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "component",
        "state",
        "log_tail",
        "error_code"
       ],
       "properties": {
        "component": {
         "type": "string"
        },
        "state": {
         "enum": [
          "pending",
          "running",
          "succeeded",
          "failed",
          "skipped"
         ]
        },
        "log_tail": {
         "type": "string",
         "maxLength": 4000
        },
        "error_code": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     },
     "ok": {
      "const": true
     }
    }
   },
   "errors": [
    "JOB_NOT_FOUND"
   ]
  },
  {
   "id": "setup.secret.put",
   "method": "PUT",
   "path": "/api/setup/secrets/{env_name}",
   "public": "loopback_only",
   "status": "new",
   "slice": "S3",
   "request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "value"
    ],
    "properties": {
     "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "ok",
     "env_name",
     "key_present"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "env_name": {
      "type": "string"
     },
     "key_present": {
      "type": "boolean"
     }
    }
   },
   "note": "写入 secrets/.env（仓库外运行目录），响应与日志永不回显 value；env_name 必须匹配 ^[A-Z][A-Z0-9_]{1,63}$ 且出现在 fleet.toml models.*.api_key_env 中",
   "errors": [
    "VALIDATION_FAILED",
    "SECRET_NAME_NOT_DECLARED"
   ]
  },
  {
   "id": "setup.model.test",
   "method": "POST",
   "path": "/api/setup/models/{name}/test",
   "public": "loopback_only",
   "status": "new",
   "slice": "S3",
   "response": {
    "type": "object",
    "required": [
     "ok",
     "reachable",
     "latency_ms",
     "detail"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "reachable": {
      "type": "boolean"
     },
     "latency_ms": {
      "type": "number"
     },
     "detail": {
      "type": "string"
     }
    }
   },
   "errors": [
    "MODEL_NOT_FOUND",
    "SECRET_MISSING"
   ]
  },
  {
   "id": "setup.login",
   "method": "POST",
   "path": "/api/setup/login/{harness}",
   "public": "loopback_only",
   "status": "new",
   "slice": "S3",
   "note": "在本机新开一个终端窗口运行该 harness 的登录命令（来自 profile.login 字段，新增）；不代填任何凭据",
   "response": {
    "type": "object",
    "required": [
     "ok",
     "launched",
     "command"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "launched": {
      "type": "boolean"
     },
     "command": {
      "type": "string"
     }
    }
   },
   "errors": [
    "HARNESS_NOT_FOUND",
    "HARNESS_NOT_INSTALLED"
   ]
  },
  {
   "id": "config.fleet.get",
   "method": "GET",
   "path": "/api/config/fleet",
   "status": "new",
   "slice": "S3",
   "response": {
    "type": "object",
    "required": [
     "ok",
     "config",
     "sources"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "config": {
      "$ref": "#/$defs/FleetToml"
     },
     "sources": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     }
    }
   },
   "public": "loopback_only",
   "note": "；首次运行尚无项目/会话，身份由回环来源承担（identity B1 意图，单用户部署）"
  },
  {
   "id": "config.fleet.put",
   "method": "PUT",
   "path": "/api/config/fleet",
   "status": "new",
   "slice": "S3",
   "request": {
    "$ref": "#/$defs/FleetToml"
   },
   "response": {
    "type": "object",
    "required": [
     "ok",
     "config"
    ],
    "properties": {
     "ok": {
      "const": true
     },
     "config": {
      "$ref": "#/$defs/FleetToml"
     }
    }
   },
   "note": "服务端校验后原子写 fleet.toml（写临时文件 + os.replace）；拒绝任何形似密钥的值（见 errors PLAINTEXT_SECRET）；首次运行尚无项目/会话，身份由回环来源承担（identity B1 意图，单用户部署）",
   "errors": [
    "VALIDATION_FAILED",
    "PLAINTEXT_SECRET",
    "WORKSPACE_NOT_ALLOWED"
   ],
   "public": "loopback_only"
  }
 ],
 "$defs": {
  "FleetToml": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "workspace": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "allowed_roots": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "minItems": 1
      }
     }
    },
    "models": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "base_url",
       "model_id",
       "api_key_env"
      ],
      "properties": {
       "base_url": {
        "type": "string",
        "pattern": "^https?://"
       },
       "model_id": {
        "type": "string"
       },
       "api_key_env": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
       },
       "priority": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    },
    "roles": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "harness": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "models": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    },
    "runtime": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "scheduler": {
       "enum": [
        "auto",
        "step",
        "off"
       ]
      },
      "lease_minutes": {
       "type": "integer",
       "minimum": 1,
       "maximum": 240
      }
     }
    }
   }
  }
 }
}
