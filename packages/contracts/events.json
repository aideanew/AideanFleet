{
  "$id": "events.json",
  "title": "Kernel 事件契约（outbox）",
  "facts": "事件与状态变更同事务写入 kernel.db events 表（已确认 kernel.py _event + store.py events）；export_events 导出 JSONL 并置 published=1",
  "$defs": {
    "Event": {
      "type": "object", "additionalProperties": false,
      "required": ["seq","ts","kind","todo_id","goal_id","payload","published"],
      "properties": {
        "seq": {"type": "integer", "description": "单调递增；消费方以 seq 作为幂等键与游标"},
        "ts": {"type": "string"}, "kind": {"$ref": "#/$defs/EventKind"},
        "todo_id": {"type": "string"}, "goal_id": {"type": "string"},
        "payload": {"type": "object"}, "published": {"enum": [0,1]}
      }
    },
    "EventKind": {"enum": [
      "goal:created","goal:done",
      "todo:created","todo:claimed","todo:running","todo:verifying","todo:done",
      "todo:successor","todo:blocked","todo:needs_user","todo:reopened","todo:lease_expired",
      "plan:diff_proposed","plan:decided","setup:step"
    ]}
  },
  "existing": ["goal:created","goal:done","todo:created","todo:claimed","todo:running","todo:verifying","todo:done","todo:successor","todo:blocked","todo:needs_user","todo:reopened","todo:lease_expired"],
  "new": {
    "plan:diff_proposed": {"slice": "S6", "trigger": "steer/plan todo 产出 PlanDiff 并进入 needs_user", "payload": {"diff": "schemas/plan-diff.json"}},
    "plan:decided": {"slice": "S6", "trigger": "POST decision 成功", "payload": {"decision": "approve|reject", "applied": "int"}},
    "setup:step": {"slice": "S2", "trigger": "安装作业每个组件状态变化", "payload": {"job_id": "string", "component": "string", "state": "pending|running|succeeded|failed|skipped", "error_code": "InstallStepErrorCode|null"},
      "note": "setup 不属于 todo 生命周期，不写 kernel.db：写入 <data_dir>/setup/jobs/<job_id>.jsonl，经 /api/setup/jobs/{id} 读取（NON_BLOCKING 假设 A-07，ADR-003）"}
  },
  "idempotency": "消费方（UI 轮询 /api/kernel/events 或 WS 推送）以 seq 去重；重复投递不得产生重复 UI 行"
}
