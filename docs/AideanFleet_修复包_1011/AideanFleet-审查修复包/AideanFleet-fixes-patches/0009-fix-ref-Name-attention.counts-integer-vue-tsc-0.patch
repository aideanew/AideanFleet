diff --git a/fleet/console/web/src/api/types.ts b/fleet/console/web/src/api/types.ts
index eb7820f..91e0ac4 100644
--- a/fleet/console/web/src/api/types.ts
+++ b/fleet/console/web/src/api/types.ts
@@ -182,7 +182,14 @@ export interface GoalsListResponse {
 }
 
 export interface AttentionResponse {
-  counts: Record<string, unknown>;
+  counts: {
+    needs_user: number;
+    running: number;
+    blocked: number;
+    done: number;
+    open: number;
+    superseded: number;
+  };
   needs_user: Array<Todo>;
   running: Array<Todo>;
   blocked: Array<Todo>;
@@ -251,7 +258,7 @@ export interface SetupStatusResponse {
 }
 
 export interface SetupInstallRequest {
-  components: Array<Name>;
+  components: Array<"python" | "node" | "npm" | "git" | "claude" | "codex" | "opencode" | "gemini" | "cline" | "grok">;
   mirror?: "auto" | "official" | "cn";
 }
 
diff --git a/packages/contracts/api.json b/packages/contracts/api.json
index 5392c95..791d30d 100644
--- a/packages/contracts/api.json
+++ b/packages/contracts/api.json
@@ -176,7 +176,33 @@
        "done",
        "open",
        "superseded"
-      ]
+      ],
+      "properties": {
+       "needs_user": {
+        "type": "integer",
+        "minimum": 0
+       },
+       "running": {
+        "type": "integer",
+        "minimum": 0
+       },
+       "blocked": {
+        "type": "integer",
+        "minimum": 0
+       },
+       "done": {
+        "type": "integer",
+        "minimum": 0
+       },
+       "open": {
+        "type": "integer",
+        "minimum": 0
+       },
+       "superseded": {
+        "type": "integer",
+        "minimum": 0
+       }
+      }
      },
      "needs_user": {
       "type": "array",
diff --git a/scripts/contracts_gen.py b/scripts/contracts_gen.py
index dce2b15..ba5dca8 100644
--- a/scripts/contracts_gen.py
+++ b/scripts/contracts_gen.py
@@ -79,7 +79,14 @@ def safe_prop(name: str) -> str:
 
 def ts_type(schema: dict, source_file: str, contracts: dict[str, dict], indent: str = "") -> str:
     if "$ref" in schema:
-        name, _ = resolve_ref(schema["$ref"], source_file, contracts)
+        name, target = resolve_ref(schema["$ref"], source_file, contracts)
+        frag = schema["$ref"].split("#", 1)[1] if "#" in schema["$ref"] else ""
+        if "/properties/" in frag:
+            # 审计修复：指向某个属性的 JSON Pointer（…/properties/name）没有对应的具名类型，
+            # 原实现输出不存在的类型名（如 Name），vue-tsc 报 TS2304。这里内联目标类型。
+            target_file = schema["$ref"].split("#", 1)[0] or source_file
+            return ts_type(target, target_file if target_file in contracts else source_file,
+                           contracts, indent)
         return name
     if "const" in schema:
         return json.dumps(schema["const"])
