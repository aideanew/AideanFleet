diff --git a/tests/conftest.py b/tests/conftest.py
index 471cf3c..7ccad5a 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -26,3 +26,33 @@ def git_porcelain() -> str | None:
 
 #: 收集阶段快照（import 时执行一次）
 PORCELAIN_AT_START = git_porcelain()
+
+
+def _tracked_mutations(porcelain: str) -> list[str]:
+    lines = []
+    for line in (porcelain or "").splitlines():
+        if not line.strip():
+            continue
+        if line[:2].strip() in ("", "?"):
+            continue  # 未跟踪不算改写
+        lines.append(line)
+    return lines
+
+
+def pytest_sessionfinish(session, exitstatus):
+    """会话结束守门（审计修复）：test_tests_do_not_mutate_tracked_files 位于 tests/architecture，
+    按收集顺序最先运行，看不到之后测试造成的改写（F-11 在 Linux 上复现即因此漏检）。
+    这里在全部测试结束后再比对一次，有新增改写则把退出码置为失败。"""
+    if PORCELAIN_AT_START is None:
+        return
+    after = git_porcelain()
+    if after is None:
+        return
+    before = set(_tracked_mutations(PORCELAIN_AT_START))
+    new = [line for line in _tracked_mutations(after) if line not in before]
+    if new:
+        reporter = session.config.pluginmanager.get_plugin("terminalreporter")
+        message = f"测试改写了已跟踪文件（REQ-NF-07）: {new}"
+        if reporter is not None:
+            reporter.write_line(message, red=True)
+        session.exitstatus = 1
diff --git a/tests/test_watch_events.py b/tests/test_watch_events.py
index c13eb7d..a677580 100644
--- a/tests/test_watch_events.py
+++ b/tests/test_watch_events.py
@@ -10,8 +10,13 @@ from fleet.notify.triggers import EventType, NotificationTrigger, watch_events_l
 
 
 def _make_trigger(test_results):
-    """构造触发器：TASK_COMPLETED 开启 + 测试回调（不真发邮件）"""
-    trigger = NotificationTrigger()
+    """构造触发器：TASK_COMPLETED 开启 + 测试回调（不真发邮件）。
+
+    配置文件落临时目录：默认路径 config/notifications.json 是已跟踪文件，
+    set_enabled 会回写它（Linux 上 CRLF→LF 造成 F-11 复发）。"""
+    import tempfile
+
+    trigger = NotificationTrigger(str(Path(tempfile.mkdtemp()) / "notifications.json"))
     trigger.set_enabled(EventType.TASK_COMPLETED, True)
 
     def test_callback(subject, body):
