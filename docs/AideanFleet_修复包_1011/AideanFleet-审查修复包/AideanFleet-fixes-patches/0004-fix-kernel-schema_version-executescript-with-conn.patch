 2 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/fleet/kernel/migrate.py b/fleet/kernel/migrate.py
index e85c143..7714352 100644
--- a/fleet/kernel/migrate.py
+++ b/fleet/kernel/migrate.py
@@ -46,11 +46,19 @@ def run(conn: sqlite3.Connection) -> list[int]:
         version = int(head)
         if version in done:
             continue
-        with conn:
-            conn.executescript(sql_path.read_text(encoding="utf-8"))
-            conn.execute(
-                "INSERT INTO schema_version (version, applied_at) VALUES (?,?)",
-                (version, datetime.now(timezone.utc).isoformat(timespec="seconds")),
+        # 审计修复：executescript 会先 COMMIT 再以自动提交逐句执行，外层 `with conn` 并不包住脚本；
+        # 中途失败会留下“半个迁移”且无 schema_version 记录，下次启动因重复列永久失败。
+        # 这里把脚本与版本记录放进同一个显式事务，失败整体回滚。
+        script = sql_path.read_text(encoding="utf-8")
+        stamp = datetime.now(timezone.utc).isoformat(timespec="seconds")
+        try:
+            conn.executescript(
+                "BEGIN;\n" + script + "\n;INSERT INTO schema_version (version, applied_at) VALUES ("
+                + str(version) + ", '" + stamp + "');\nCOMMIT;"
             )
+        except Exception:
+            if conn.in_transaction:
+                conn.rollback()
+            raise
         applied_now.append(version)
     return applied_now
diff --git a/tests/kernel/test_migrations.py b/tests/kernel/test_migrations.py
index 82dea00..1950310 100644
--- a/tests/kernel/test_migrations.py
+++ b/tests/kernel/test_migrations.py
@@ -85,3 +85,30 @@ def test_migrations_packaged_copy_matches_source():
     for name in source:
         assert (packaged_dir / name).read_text(encoding="utf-8") == \
                (root / "database" / "migrations" / name).read_text(encoding="utf-8"), name
+
+
+def test_failed_migration_rolls_back_atomically(tmp_path, monkeypatch):
+    """审计回归：迁移脚本中途失败必须整体回滚（不留半个迁移、不记版本）。"""
+    import sqlite3
+
+    import pytest
+
+    from fleet.kernel import migrate
+
+    mig = tmp_path / "migs"
+    mig.mkdir()
+    (mig / "001_base.sql").write_text("CREATE TABLE t (a TEXT);\n", encoding="utf-8")
+    (mig / "002_bad.sql").write_text(
+        "ALTER TABLE t ADD COLUMN b TEXT;\nALTER TABLE no_such_table ADD COLUMN x TEXT;\n",
+        encoding="utf-8")
+    monkeypatch.setattr(migrate, "migrations_dir", lambda: mig)
+    conn = sqlite3.connect(tmp_path / "k.db")
+    conn.row_factory = sqlite3.Row
+    with pytest.raises(sqlite3.OperationalError):
+        migrate.run(conn)
+    cols = [r["name"] for r in conn.execute("PRAGMA table_info(t)")]
+    assert cols == ["a"], cols  # 002 的第一句也被回滚
+    assert migrate.applied_versions(conn) == {1}
+    (mig / "002_bad.sql").write_text("ALTER TABLE t ADD COLUMN b TEXT;\n", encoding="utf-8")
+    assert migrate.run(conn) == [2]
+    conn.close()
