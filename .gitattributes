# AideanFleet .gitattributes — 统一换行符策略（O-12 修复）
# 防止 CRLF/LF 互转噪声导致测试失败和 diff 污染

# 文本文件统一用 LF
*.py     text eol=lf
*.ts     text eol=lf
*.vue    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.txt    text eol=lf
*.sql    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.svg    text eol=lf
*.iss    text eol=lf
*.ps1    text eol=lf
*.sh     text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.env.example text eol=lf
.env.development text eol=lf
env.d.ts text eol=lf

# Windows 批处理保持 CRLF
*.cmd    text eol=crlf
*.bat    text eol=crlf

# 二进制文件
*.png    binary
*.jpg    binary
*.ico    binary
*.whl    binary
*.zip    binary
*.tar.xz binary
*.docx   binary
*.bundle binary
*.patch  text eol=lf
